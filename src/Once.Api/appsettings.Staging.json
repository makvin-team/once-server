{
  "ConnectionStrings": {
    "DefaultConnectionString": "Host=;Database=stage_once_db;Username=postgres;Password=root;Pooling=true;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "flushToDiskInterval": 1,
          "rollingInterval": "Day"
        }
      }
    ]
  }
}